# --- MARIADB ---
DB_NAME=wordpress          # Nom de la base de données (peut rester "wordpress")
DB_USER=wpuser             # Nom de l'utilisateur MariaDB dédié à WordPress (pas root, choisis ce que tu veux)
DB_PASSWORD=Motdepasse42!  # Mot de passe de cet utilisateur (invente un mot de passe)
DB_ADMIN_PASS=RootPass42!  # Mot de passe du compte root MariaDB (invente un mot de passe)

# --- NGINX / WORDPRESS ---
DOMAIN_NAME=pchazalm.42.fr  # Déjà bon, ne touche pas

# --- COMPTE ADMIN WORDPRESS ---
WP_USER=pchazalm            # Ton login 42, ce sera l'admin du site
WP_PASS=Admin42!            # Mot de passe de l'admin WordPress (invente)
WP_MAIL=pchazalm@student.42.fr  # Email de l'admin (peut être inventé)

# --- SECOND COMPTE WORDPRESS (auteur/éditeur) ---
WP_USER2=editor             # Un deuxième utilisateur (pas admin, choisis un nom)
WP_PASS2=Editor42!          # Son mot de passe
WP_MAIL2=editor@student.42.fr   # Son email (peut être inventé)
